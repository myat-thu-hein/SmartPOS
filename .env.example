# SmartPOS AI environment. Copy to .env and fill in real values.
# Never commit .env: it holds secrets. Every value here is a placeholder.

# --- Runtime ---------------------------------------------------------------
# development: demo seed allowed, API docs on, password-reset links logged to the console.
# production:  strict checks (strong SECRET_KEY, secure cookies, no console email).
APP_ENV=development

# Random, at least 32 characters:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-value

# --- Database (docker compose) ------------------------------------------------
POSTGRES_DB=smartpos
POSTGRES_USER=smartpos
POSTGRES_PASSWORD=replace-with-a-database-password
# To use Supabase, Neon (or any PostgreSQL 15+) instead of the local db container, set:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# Pooled URLs are fine; give migrations a direct connection when you have one:
# MIGRATION_DATABASE_URL=postgresql://USER:PASSWORD@DIRECT-HOST:5432/postgres
# Without docker compose, the backend defaults to postgresql://smartpos:smartpos@localhost:5432/smartpos.

# Apply database migrations when the backend container starts (set false in production
# and run them as a deliberate deployment step).
RUN_MIGRATIONS=true

# --- Web ---------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
FRONTEND_PORT=3000
# Origins allowed to call the API directly from a browser (docker compose uses FRONTEND_URL).
# CORS_ORIGINS=http://localhost:3000
# true when served over HTTPS (always in production)
COOKIE_SECURE=false

# Use the first X-Forwarded-For address as the client IP (rate limits, audit log).
# Only safe behind a proxy that overwrites the header: Vercel, or docker compose's frontend.
# TRUST_FORWARDED_FOR=false

# --- Demo data -------------------------------------------------------------------
# SEED_DEMO=true loads the synthetic "Baan Siam (Demo)" restaurant on start-up.
# Demo accounts: admin@ / manager@ / cashier@ / kitchen@smartpos.demo with DEMO_PASSWORD.
# Changing DEMO_PASSWORD and restarting (or re-running the seed) updates their password.
SEED_DEMO=false
DEMO_PASSWORD=
# Public portfolio demo: one-click "Manager / Cashier / Kitchen" sign-in on the login page.
# Shared demo accounts cannot change their sign-in details or manage staff.
DEMO_LOGIN_ENABLED=false
# Vercel Cron sends this as a bearer token to refresh the demo data nightly (16+ random characters).
CRON_SECRET=

# --- Email (password reset) ------------------------------------------------------
# console (development default) | smtp | disabled (production default)
EMAIL_BACKEND=
EMAIL_FROM=SmartPOS AI <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- AI assistant (optional) ------------------------------------------------------
# Without a key the assistant uses the built-in rule-based engine.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
